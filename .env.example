NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (/admin/login)
ADMIN_USERNAME=FyzX
ADMIN_PASSWORD=Momin@7764
ADMIN_SESSION_SECRET=

# GodofPanel (PerfectPanel v2). Paste the API key when you have it.
GODOFPANEL_API_URL=https://godofpanel.com/api/v2
GODOFPANEL_API_KEY=

# Optional JSON map of retail catalog IDs to GodofPanel service IDs
# Example: {"101": 1234, "102": 5678}
GODOFPANEL_SERVICE_MAP=

# Retail markup over provider cost, e.g. 80 = 1.8x
MARKUP_PERCENT=80

# PayPal REST (Checkout). Use live credentials on production.
# Webhook URL: https://cheapfollower.shop/api/payments/paypal/webhook
# Subscribe to CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# NOWPayments crypto invoices. IPN URL: https://cheapfollower.shop/api/payments/nowpayments/ipn
NOWPAYMENTS_MODE=live
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
